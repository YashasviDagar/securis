# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but always keep the template tracked so contributors know which variables
# are required. Never remove this negation.
!.env.example

# Local, personal phase documentation. Intentionally NOT committed: it is the
# author's private learning log describing what each build phase covers.
/phase-notes/

# Local Prisma development state (created by `npx prisma dev`).
.prisma/
/.prisma/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
