# =============================================================================
# Securis - Environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# NEVER commit `.env` - it is listed in .gitignore. Only this template is
# tracked in git. No secret value is ever hard-coded in the source tree.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Development (no Docker required): run `npx prisma dev --detach`, then copy the
# connection strings it prints. The values below are the defaults it uses.
#
# Production: replace with the Neon connection strings:
#   DATABASE_URL          -> pooled connection string (used by the app)
#   SHADOW_DATABASE_URL   -> direct connection string (used by migrations)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=1&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# -----------------------------------------------------------------------------
# Session security (Phase 3)
# -----------------------------------------------------------------------------
# Secret used to sign/derive session tokens and CSRF tokens. Must be a long,
# random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Session lifetime in minutes before the user must sign in again.
SESSION_TTL_MINUTES="480"

# -----------------------------------------------------------------------------
# Event ingestion (Phase 4)
# -----------------------------------------------------------------------------
# Shared secret that external collectors must present when POSTing events to
# /api/ingest. Keep it distinct from SESSION_SECRET.
INGEST_API_KEY="replace-with-a-long-random-ingest-key"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public base URL of the application (used for absolute links and CORS checks).
APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Rate limiting (Phase 3 / Phase 18)
# -----------------------------------------------------------------------------
# Login attempts allowed per window before an account/IP is throttled.
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="300"
# Generic API requests allowed per window per client.
API_RATE_LIMIT_MAX="120"
API_RATE_LIMIT_WINDOW_SECONDS="60"
